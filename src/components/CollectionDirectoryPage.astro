---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  addressesForPage,
  collectionPath,
  safeJsonLd,
  ADDRESSES_PER_COLLECTION,
  type DirectoryCollection,
  type DirectoryEntry,
} from "../lib/getDirectory";

export interface Props {
  entry: DirectoryEntry;
  page: number;
  others: DirectoryCollection[];
}

const { entry, page, others } = Astro.props;
const { collection, totalPages, addresses: all } = entry;
const rows = addressesForPage(all, page);

const shown = Math.min(all.length, ADDRESSES_PER_COLLECTION);
const rangeStart = (page - 1) * 100 + 1;
const rangeEnd = Math.min(page * 100, shown);

const pageSuffix = page > 1 ? ` — Page ${page} of ${totalPages}` : "";
const title = `${collection.name} address directory${pageSuffix} | Yellowdex`;
const baseDescription = collection.description
  ? collection.description
  : `Public directory of labeled ${collection.name} crypto addresses.`;
const description =
  `${baseDescription} Browsing ${rangeStart}–${rangeEnd} of ${shown} labeled addresses in the ${collection.name} collection on Yellowdex.`.slice(
    0,
    300,
  );

const site = Astro.site;
const canonicalPath = collectionPath(collection.slug, page);
const canonical = site ? new URL(canonicalPath, site).toString() : canonicalPath;
const prevPath = page > 1 ? collectionPath(collection.slug, page - 1) : null;
const nextPath = page < totalPages ? collectionPath(collection.slug, page + 1) : null;
const prevUrl = prevPath && site ? new URL(prevPath, site).toString() : prevPath;
const nextUrl = nextPath && site ? new URL(nextPath, site).toString() : nextPath;

// Build a compact, absolute-only page window for the pagination control.
const windowSize = 2;
const pageNumbers: number[] = [];
for (let p = 1; p <= totalPages; p++) {
  if (p === 1 || p === totalPages || Math.abs(p - page) <= windowSize) {
    pageNumbers.push(p);
  }
}

function fmtCount(n: number): string {
  return new Intl.NumberFormat("en").format(n);
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${collection.name} address directory`,
  description: baseDescription,
  url: canonical,
  isPartOf: {
    "@type": "WebSite",
    name: "Yellowdex",
    url: site ? site.toString() : "https://yellowdex.ai/",
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: rows.length,
    itemListElement: rows.map((row, i) => ({
      "@type": "ListItem",
      position: (page - 1) * 100 + i + 1,
      name: row.label || row.address,
    })),
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Directory",
      item: site ? new URL("/directory/", site).toString() : "/directory/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: collection.name,
      item: site
        ? new URL(collectionPath(collection.slug, 1), site).toString()
        : collectionPath(collection.slug, 1),
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />
    <script type="application/ld+json" set:html={safeJsonLd(breadcrumbLd)} />
  </Fragment>

  <header class="sticky top-0 z-20 bg-paper/80 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo-yellowdex.svg" alt="Yellowdex logo" class="h-10 w-10" />
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Yellowdex</p>
          <p class="font-display text-lg text-ink">Label every address. Turn chaos into context.</p>
        </div>
      </a>
      <nav aria-label="Primary navigation" class="hidden shrink-0 items-center gap-5 whitespace-nowrap text-sm font-medium text-ink-soft lg:flex">
        <a href="/#features" class="transition hover:text-ink">Features</a>
        <a href="/api-docs/" class="transition hover:text-ink">API</a>
        <a href="/directory/" class="transition hover:text-ink">Directory</a>
        <a href="/blog/" class="transition hover:text-ink">Blog</a>
        <a href="/releases/" class="transition hover:text-ink">Release notes</a>
        <a href="/#how-it-works" class="transition hover:text-ink">How it works</a>
        <a href="/#faq" class="transition hover:text-ink">FAQ</a>
        <a
          href="https://chromewebstore.google.com/detail/lapdeiobkgdfjfcdddjbmmhooicppmha"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Install Yellowdex on Chrome"
          class="rounded-full bg-charcoal px-4 py-2 text-sm font-semibold text-sun shadow-lg shadow-amber/30 transition hover:-translate-y-0.5 hover:shadow-xl"
        >
          Install on Chrome
        </a>
      </nav>
    </div>
  </header>

  <main id="main" class="px-6 py-12 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <a href="/directory/" class="inline-flex items-center gap-2 font-medium transition hover:text-ink">
          <span aria-hidden="true">&larr;</span> All collections
        </a>
      </nav>

      <div class="mt-6 space-y-3">
        <p class="pill">Address directory</p>
        <h1 class="font-display text-4xl font-semibold text-charcoal">{collection.name}</h1>
        {collection.description && (
          <p class="max-w-2xl text-muted">{collection.description}</p>
        )}
        <p class="text-sm text-muted">
          {fmtCount(collection.addressCount)} labeled addresses in this collection
          {collection.addressCount > shown && (
            <> · showing the first {fmtCount(shown)}</>
          )}
          {totalPages > 1 && <> · page {page} of {totalPages}</>}
        </p>
      </div>

      <section aria-label={`${collection.name} addresses`} class="card mt-8 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-left text-sm">
            <caption class="sr-only">
              {collection.name} labeled addresses, {rangeStart} to {rangeEnd} of {fmtCount(shown)}
            </caption>
            <thead>
              <tr class="border-b border-black/5 bg-panel/40 text-xs uppercase tracking-wide text-muted">
                <th scope="col" class="px-4 py-3 font-semibold">Address</th>
                <th scope="col" class="px-4 py-3 font-semibold">Label</th>
                <th scope="col" class="px-4 py-3 font-semibold">Entity</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr class="border-b border-black/5 align-top last:border-0 hover:bg-panel/20">
                  <td class="px-4 py-3">
                    <code class="break-all font-mono text-xs text-ink-soft">{row.address}</code>
                  </td>
                  <td class="px-4 py-3 text-ink">{row.label || "—"}</td>
                  <td class="px-4 py-3 text-muted">{row.entity || "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {totalPages > 1 && (
        <nav aria-label="Pagination" class="mt-8 flex flex-wrap items-center justify-center gap-2">
          {prevPath ? (
            <a
              href={prevPath}
              rel="prev"
              class="rounded-full border border-black/10 bg-card px-4 py-2 text-sm font-medium text-ink transition hover:border-black/20 hover:bg-panel/40"
            >
              &larr; Prev
            </a>
          ) : (
            <span class="rounded-full border border-black/5 px-4 py-2 text-sm font-medium text-muted/50">&larr; Prev</span>
          )}

          {pageNumbers.map((p, i) => (
            <>
              {i > 0 && pageNumbers[i] - pageNumbers[i - 1] > 1 && (
                <span class="px-1 text-muted">…</span>
              )}
              {p === page ? (
                <span
                  aria-current="page"
                  class="rounded-full bg-charcoal px-4 py-2 text-sm font-semibold text-sun"
                >
                  {p}
                </span>
              ) : (
                <a
                  href={collectionPath(collection.slug, p)}
                  class="rounded-full border border-black/10 bg-card px-4 py-2 text-sm font-medium text-ink transition hover:border-black/20 hover:bg-panel/40"
                >
                  {p}
                </a>
              )}
            </>
          ))}

          {nextPath ? (
            <a
              href={nextPath}
              rel="next"
              class="rounded-full border border-black/10 bg-card px-4 py-2 text-sm font-medium text-ink transition hover:border-black/20 hover:bg-panel/40"
            >
              Next &rarr;
            </a>
          ) : (
            <span class="rounded-full border border-black/5 px-4 py-2 text-sm font-medium text-muted/50">Next &rarr;</span>
          )}
        </nav>
      )}

      {others.length > 0 && (
        <section aria-label="Other public collections" class="mt-16">
          <h2 class="font-display text-2xl text-charcoal">Explore other collections</h2>
          <p class="mt-1 text-sm text-muted">Browse more labeled address collections in the Yellowdex directory.</p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((other) => (
              <li>
                <a
                  href={collectionPath(other.slug, 1)}
                  class="card flex h-full flex-col gap-1 p-4 transition hover:-translate-y-0.5 hover:shadow-xl"
                >
                  <span class="font-display text-lg text-ink">{other.name}</span>
                  {other.description && (
                    <span class="line-clamp-2 text-sm text-muted">{other.description}</span>
                  )}
                  <span class="mt-1 text-xs font-medium uppercase tracking-wide text-amber">
                    {fmtCount(other.addressCount)} addresses
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>

  <footer class="border-t border-charcoal/10 bg-paper/80 px-6 py-10 lg:px-8">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <img src="/logo-yellowdex.svg" alt="Yellowdex" class="h-10 w-10" />
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Yellowdex</p>
          <p class="text-sm text-ink-soft">Label every address. Turn chaos into context.</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted">
        <a href="/#features" class="hover:text-ink">Features</a>
        <a href="/directory/" class="hover:text-ink">Directory</a>
        <a href="/blog/" class="hover:text-ink">Blog</a>
        <a href="/#how-it-works" class="hover:text-ink">How it works</a>
        <a href="/#faq" class="hover:text-ink">FAQ</a>
        <a href="/brand-assets/" class="hover:text-ink">Brand Assets</a>
        <a href="mailto:support@yellowdex.ai" class="hover:text-ink">Contact</a>
        <a href="/privacy-policy/" class="hover:text-ink">Privacy Policy</a>
        <a href="/llms.txt" class="hover:text-ink">llms.txt</a>
      </div>
    </div>
  </footer>
</BaseLayout>
