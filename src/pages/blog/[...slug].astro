---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { safeJsonLd } from "../../lib/getDirectory";
import { getPublishedPosts, postPath, isoDate, displayDate, type BlogPost } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, category, readingTime, pubDate, ogImage } = post.data;

const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : path);
const url = abs(postPath(post));

const blogPostingLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: isoDate(pubDate),
  dateModified: isoDate(pubDate),
  url,
  mainEntityOfPage: url,
  author: { "@type": "Organization", name: "Yellowdex" },
  publisher: {
    "@type": "Organization",
    name: "Yellowdex",
    logo: { "@type": "ImageObject", url: abs("/logo-yellowdex.png") },
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: abs("/") },
    { "@type": "ListItem", position: 2, name: "Blog", item: abs("/blog/") },
    { "@type": "ListItem", position: 3, name: title, item: url },
  ],
};
---

<BaseLayout title={`${title} | Yellowdex`} description={description} ogImage={ogImage ?? "/og-yellowdex.png"}>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="The Yellowdex blog" href="/blog/rss.xml" />
    <meta property="article:published_time" content={isoDate(pubDate)} />
    <script type="application/ld+json" set:html={safeJsonLd(blogPostingLd)} />
    <script type="application/ld+json" set:html={safeJsonLd(breadcrumbLd)} />
  </Fragment>

  <header class="sticky top-0 z-20 bg-paper/80 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 lg:px-8">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo-yellowdex.svg" alt="Yellowdex logo" class="h-10 w-10" />
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Yellowdex</p>
          <p class="font-display text-lg text-ink">Label every address. Turn chaos into context.</p>
        </div>
      </a>
      <nav aria-label="Primary navigation" class="hidden items-center gap-6 text-sm font-medium text-ink-soft lg:flex">
        <a href="/#features" class="transition hover:text-ink">Features</a>
        <a href="/directory/" class="transition hover:text-ink">Directory</a>
        <a href="/blog/" class="transition hover:text-ink">Blog</a>
        <a href="/releases/" class="transition hover:text-ink">Release notes</a>
        <a href="/#faq" class="transition hover:text-ink">FAQ</a>
        <a
          href="https://chromewebstore.google.com/detail/lapdeiobkgdfjfcdddjbmmhooicppmha"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Install Yellowdex on Chrome"
          class="rounded-full bg-charcoal px-4 py-2 text-sm font-semibold text-sun shadow-lg shadow-amber/30 transition hover:-translate-y-0.5 hover:shadow-xl"
        >
          Install on Chrome
        </a>
      </nav>
    </div>
  </header>

  <main id="main" class="px-6 py-12 lg:px-8">
    <article class="mx-auto max-w-3xl">
      <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-medium text-muted transition hover:text-ink">
        <span aria-hidden="true">&larr;</span> All posts
      </a>

      <div class="mt-8 space-y-3">
        <p class="pill">{category}</p>
        <h1 class="font-display text-4xl font-semibold leading-tight text-charcoal">{title}</h1>
        <div class="flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-wide text-muted">
          <time datetime={isoDate(pubDate)}>{displayDate(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime}</span>
        </div>
      </div>

      <div
        class="mt-10 max-w-none text-base leading-relaxed
          prose prose-slate
          prose-headings:font-display prose-headings:text-ink
          prose-h2:mt-10 prose-h2:text-2xl prose-h3:mt-6 prose-h3:text-lg
          prose-p:text-muted prose-li:text-muted prose-strong:text-ink
          prose-a:font-medium prose-a:text-ink prose-a:decoration-amber/50
          prose-a:underline-offset-2 hover:prose-a:decoration-amber"
      >
        <Content />
      </div>
    </article>
  </main>

  <footer class="border-t border-charcoal/10 bg-paper/80 px-6 py-10 lg:px-8">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <img src="/logo-yellowdex.svg" alt="Yellowdex" class="h-10 w-10" />
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Yellowdex</p>
          <p class="text-sm text-ink-soft">Label every address. Turn chaos into context.</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted">
        <a href="/#features" class="hover:text-ink">Features</a>
        <a href="/directory/" class="hover:text-ink">Directory</a>
        <a href="/blog/" class="hover:text-ink">Blog</a>
        <a href="/#faq" class="hover:text-ink">FAQ</a>
        <a href="/brand-assets/" class="hover:text-ink">Brand Assets</a>
        <a href="mailto:support@yellowdex.ai" class="hover:text-ink">Contact</a>
        <a href="/privacy-policy/" class="hover:text-ink">Privacy Policy</a>
        <a href="/llms.txt" class="hover:text-ink">llms.txt</a>
      </div>
    </div>
  </footer>
</BaseLayout>
