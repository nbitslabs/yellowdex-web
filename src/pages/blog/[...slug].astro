---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { safeJsonLd } from "../../lib/getDirectory";
import { getPublishedPosts, postPath, isoDate, displayDate, type BlogPost } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, category, readingTime, pubDate, ogImage } = post.data;

const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : path);
const url = abs(postPath(post));

// Per-post social image is generated at build time by
// src/pages/blog/og/[...slug].png.ts; a post may override it via frontmatter.
const socialImage = ogImage ?? `/blog/og/${post.id}.png`;

const blogPostingLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: isoDate(pubDate),
  dateModified: isoDate(pubDate),
  url,
  mainEntityOfPage: url,
  author: { "@type": "Organization", name: "Yellowdex" },
  publisher: {
    "@type": "Organization",
    name: "Yellowdex",
    logo: { "@type": "ImageObject", url: abs("/logo-yellowdex.png") },
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: abs("/") },
    { "@type": "ListItem", position: 2, name: "Blog", item: abs("/blog/") },
    { "@type": "ListItem", position: 3, name: title, item: url },
  ],
};
---

<BaseLayout title={`${title} | Yellowdex`} description={description} ogImage={socialImage}>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="The Yellowdex blog" href="/blog/rss.xml" />
    <meta property="article:published_time" content={isoDate(pubDate)} />
    <script type="application/ld+json" set:html={safeJsonLd(blogPostingLd)} />
    <script type="application/ld+json" set:html={safeJsonLd(breadcrumbLd)} />
  </Fragment>

  <SiteHeader />

  <main id="main" class="px-6 py-12 lg:px-8">
    <article class="mx-auto max-w-3xl">
      <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-medium text-muted transition hover:text-ink">
        <span aria-hidden="true">&larr;</span> All posts
      </a>

      <div class="mt-8 space-y-3">
        <p class="pill">{category}</p>
        <h1 class="font-display text-4xl font-semibold leading-tight text-charcoal">{title}</h1>
        <div class="flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-wide text-muted">
          <time datetime={isoDate(pubDate)}>{displayDate(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime}</span>
        </div>
      </div>

      <div
        class="mt-10 max-w-none text-base leading-relaxed
          prose prose-slate
          prose-headings:font-display prose-headings:text-ink
          prose-h2:mt-10 prose-h2:text-2xl prose-h3:mt-6 prose-h3:text-lg
          prose-p:text-muted prose-li:text-muted prose-strong:text-ink
          prose-a:font-medium prose-a:text-ink prose-a:decoration-amber/50
          prose-a:underline-offset-2 hover:prose-a:decoration-amber"
      >
        <Content />
      </div>
    </article>
  </main>

  <footer class="border-t border-charcoal/10 bg-paper/80 px-6 py-10 lg:px-8">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <img src="/logo-yellowdex.svg" alt="Yellowdex" class="h-10 w-10" />
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Yellowdex</p>
          <p class="text-sm text-ink-soft">Label every address. Turn chaos into context.</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted">
        <a href="/#features" class="hidden hover:text-ink lg:inline">Features</a>
        <a href="/directory/" class="hidden hover:text-ink lg:inline">Directory</a>
        <a href="/blog/" class="hidden hover:text-ink lg:inline">Blog</a>
        <a href="/#faq" class="hidden hover:text-ink lg:inline">FAQ</a>
        <a href="/brand-assets/" class="hidden hover:text-ink lg:inline">Brand Assets</a>
        <a href="mailto:support@yellowdex.ai" class="hover:text-ink">Contact</a>
        <a href="/privacy-policy/" class="hover:text-ink">Privacy Policy</a>
        <a href="/llms.txt" class="hover:text-ink">llms.txt</a>
        <a href="https://x.com/yellowdex_ai" target="_blank" rel="noopener noreferrer" aria-label="Follow Yellowdex on X" class="hover:text-ink">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
