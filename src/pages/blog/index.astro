---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { safeJsonLd } from "../../lib/getDirectory";
import { getPublishedPosts, postPath, isoDate, displayDate } from "../../lib/blog";

const posts = await getPublishedPosts();

const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : path);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "The Yellowdex blog",
  description:
    "Notes on labeling crypto addresses, on-chain context, and how Yellowdex fits alongside blockchain intelligence tools.",
  url: abs("/blog/"),
  publisher: { "@type": "Organization", name: "Yellowdex" },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: isoDate(post.data.pubDate),
    url: abs(postPath(post)),
  })),
};
---

<BaseLayout
  title="Blog - Yellowdex"
  description="Notes on labeling crypto addresses, on-chain context, and how Yellowdex fits alongside blockchain intelligence tools."
  ogImage="/blog/og.png"
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="The Yellowdex blog" href="/blog/rss.xml" />
    <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />
  </Fragment>

  <SiteHeader />

  <main id="main" class="px-6 py-12 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-muted transition hover:text-ink">
        <span aria-hidden="true">&larr;</span> Back to Yellowdex
      </a>

      <div class="mt-8 space-y-3">
        <div class="flex flex-wrap items-center gap-3">
          <p class="pill">Blog</p>
          <a
            href="/blog/rss.xml"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-muted transition hover:text-ink"
          >
            <img src="/rss.svg" alt="" class="h-4 w-4" width="16" height="16" aria-hidden="true" />
            RSS
          </a>
        </div>
        <h1 class="font-display text-4xl font-semibold text-charcoal">The Yellowdex blog</h1>
        <p class="max-w-2xl text-muted">
          Notes on labeling crypto addresses, keeping context close to the surface, and how a
          browser-native labeling layer fits alongside the bigger blockchain intelligence tools.
        </p>
      </div>

      {posts.length > 0 ? (
        <div class="mt-10 space-y-6">
          {posts.map((post) => (
            <article class="card p-6 transition hover:-translate-y-0.5 hover:shadow-xl">
              <a href={postPath(post)} class="block">
                <div class="flex flex-wrap items-center gap-3 text-xs font-medium uppercase tracking-wide text-muted">
                  <time datetime={isoDate(post.data.pubDate)}>{displayDate(post.data.pubDate)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{post.data.readingTime}</span>
                </div>
                <h2 class="mt-3 font-display text-2xl text-charcoal">{post.data.title}</h2>
                <p class="mt-2 text-muted">{post.data.description}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-amber transition hover:text-ink">
                  Read more <span aria-hidden="true">&rarr;</span>
                </span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="card mt-10 p-6">
          <h2 class="font-display text-xl text-charcoal">No posts yet</h2>
          <p class="mt-2 text-muted">Check back soon — the first post is on its way.</p>
        </div>
      )}
    </div>
  </main>

  <footer class="border-t border-charcoal/10 bg-paper/80 px-6 py-10 lg:px-8">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <img src="/logo-yellowdex.svg" alt="Yellowdex" class="h-10 w-10" />
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Yellowdex</p>
          <p class="text-sm text-ink-soft">Label every address. Turn chaos into context.</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted">
        <a href="/#features" class="hidden hover:text-ink lg:inline">Features</a>
        <a href="/directory/" class="hidden hover:text-ink lg:inline">Directory</a>
        <a href="/blog/" class="hidden hover:text-ink lg:inline">Blog</a>
        <a href="/#faq" class="hidden hover:text-ink lg:inline">FAQ</a>
        <a href="/brand-assets/" class="hidden hover:text-ink lg:inline">Brand Assets</a>
        <a href="mailto:support@yellowdex.ai" class="hover:text-ink">Contact</a>
        <a href="/privacy-policy/" class="hover:text-ink">Privacy Policy</a>
        <a href="/llms.txt" class="hover:text-ink">llms.txt</a>
      </div>
    </div>
  </footer>
</BaseLayout>
